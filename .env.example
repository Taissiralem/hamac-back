# Base de données (en dev : npm run db:dev puis mongodb://localhost:27017/hamac)
DB_URI=mongodb://localhost:27017/hamac
PORT=5000
JWT_SECRET_KEY=change-me
# Origines autorisées (front), séparées par des virgules
CORS_ORIGINS=http://localhost:3000,https://hamac-events.com,https://www.hamac-events.com
# Stockage des images : "local" (dossier uploads/) ou Cloudinary si CLOUD_NAME est défini
UPLOAD_DRIVER=local
PUBLIC_URL=http://localhost:5000
CLOUD_NAME=
API_KEY=
API_SECRET=
